---
import { getCollection } from "astro:content";
import { IndexPage } from "../components/IndexPage";
import Page from "../layouts/Page.astro";
import { cookStats } from "../lib/cook-log";
import type { Recipe } from "../lib/recipe-rules";

const recipes = (await getCollection("recipes")).map((entry) => {
  const recipe = entry.data as Recipe;
  return {
    slug: entry.id,
    title: recipe.title,
    rating: recipe.rating,
    totalMinutes: recipe.totalMinutes,
    timesMade: cookStats(recipe.log).timesMade,
    lastMade: cookStats(recipe.log).lastMade,
    tags: recipe.tags,
  };
});
---

<Page>
  <IndexPage recipes={recipes} client:load />
</Page>
